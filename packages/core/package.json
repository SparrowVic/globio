{
  "name": "@globiojs/core",
  "version": "1.0.0",
  "description": "Framework-agnostic interactive 3D globe core",
  "keywords": [
    "3d",
    "data-visualization",
    "globe",
    "three.js",
    "webgl"
  ],
  "homepage": "https://globiojs.dev",
  "bugs": {
    "url": "https://github.com/SparrowVic/globiojs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparrowVic/globiojs.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./docs/api.json": "./docs/api.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/api.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "dependencies": {
    "d3-geo": "^3.1.0",
    "earcut": "^2.2.4",
    "three-mesh-bvh": "^0.7.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/earcut": "^2.1.4",
    "@types/three": "^0.160.0",
    "@types/topojson-client": "^3.1.4",
    "three": "^0.160.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Wiktor Wróbel"
}

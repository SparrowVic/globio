{
  "name": "@your-globe/core",
  "version": "0.1.0",
  "description": "Framework-agnostic interactive 3D globe core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "dependencies": {
    "d3-geo": "^3.1.0",
    "earcut": "^2.2.4",
    "three-mesh-bvh": "^0.7.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/earcut": "^2.1.4",
    "@types/three": "^0.160.0",
    "@types/topojson-client": "^3.1.4",
    "three": "^0.160.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

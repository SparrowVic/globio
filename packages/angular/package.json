{
  "name": "@globiojs/angular",
  "version": "0.1.0",
  "description": "Angular standalone component for the GlobioJS 3D globe engine",
  "author": "Wiktor Wróbel",
  "license": "MIT",
  "keywords": [
    "3d",
    "angular",
    "data-visualization",
    "globe",
    "three.js",
    "webgl"
  ],
  "homepage": "https://github.com/SparrowVic/globiojs#readme",
  "bugs": {
    "url": "https://github.com/SparrowVic/globiojs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparrowVic/globiojs.git",
    "directory": "packages/angular"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "dev": "ng-packagr -p ng-package.json -c tsconfig.lib.json --watch",
    "typecheck": "ngc -p tsconfig.lib.json --noEmit",
    "check:package": "node ./scripts/verify-package.mjs",
    "clean": "rm -rf dist .angular .turbo"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0 <23.0.0",
    "@angular/core": ">=17.0.0 <23.0.0",
    "@globiojs/core": "^0.1.0"
  },
  "dependencies": {
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular/common": "17.3.12",
    "@angular/compiler": "17.3.12",
    "@angular/compiler-cli": "17.3.12",
    "@angular/core": "17.3.12",
    "@globiojs/core": "workspace:^",
    "ng-packagr": "17.3.0",
    "rxjs": "^7.8.2",
    "three": "^0.167.1",
    "typescript": "~5.4.5"
  },
  "publishConfig": {
    "access": "public"
  }
}

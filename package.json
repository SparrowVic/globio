{
  "name": "globiojs-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive animated globe library for Angular, React and Vue",
  "scripts": {
    "build": "pnpm docs:extract && turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "node scripts/version-packages.mjs",
    "release": "node scripts/publish-packages.mjs",
    "docs:extract": "node scripts/docs-extract.mjs",
    "docs:check": "node scripts/docs-extract.mjs --check",
    "test:packages": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.11.0",
    "turbo": "^1.12.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "pnpm": {
    "overrides": {
      "three": "0.167.1",
      "@types/three": "0.167.0"
    }
  }
}
